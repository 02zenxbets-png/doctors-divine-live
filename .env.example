# ============================================================
# Doctors Divine — environment variables
# Copy this file to .env.local for local runs, and set the SAME values
# in Vercel (Project -> Settings -> Environment Variables) for deploy.
# PLACEHOLDERS ONLY below — never put real keys or passwords in this file.
# ============================================================

# Supabase project URL (Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase SERVICE-ROLE key (Project Settings -> API -> service_role key).
# SECRET. Server only — never use a NEXT_PUBLIC_ name for this key, and
# never paste it into the browser, a chat, or the repo.
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key-here

# Dashboard admin password, as a bcrypt hash (NOT the password itself).
# Generate it with:  npm run hash-password -- "YourStrongPasswordHere"
ADMIN_PASSWORD_HASH=paste-bcrypt-hash-here

# Optional but recommended: long random string used to sign the dashboard
# session cookie. Any long random text works, e.g. from a password generator.
# If left empty, a secret is derived from ADMIN_PASSWORD_HASH instead.
ADMIN_SESSION_SECRET=paste-a-long-random-string-here

# Email alerts (optional). Without these, email alerts stay OFF and bookings
# still save normally — the dashboard will show "Email off".
# Resend API key from https://resend.com/api-keys (free tier, no card).
RESEND_API_KEY=
# Sender address shown on alert emails. On Resend's free tier without a
# verified domain, keep onboarding@resend.dev (it only sends to the account
# owner's email — see README "Email alerts" for the domain step).
RESEND_FROM=Doctors Divine <onboarding@resend.dev>
